# ai-tutor backend — environment variables
# Copy to .env and fill in. Never commit the real .env.

# ---- Core ----
PORT=5002

# Extra browser origins allowed to call this API, comma-separated.
# Set this to your deployed frontend URL (e.g. the Amplify domain) or its
# requests will be blocked by CORS.
FRONTEND_ORIGINS=
JWT_SECRET=change-me
AI_DB_URI=your-mongodb-connection-string
LMS_DB_URI=your-mongodb-connection-string

# ---- Legacy AI providers (fallback path; used only when USE_BEDROCK != true / BEDROCK_KB_ID unset) ----
GROQ_API_KEY=
# Groq retires model ids; list yours with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL_ID=openai/gpt-oss-120b
JINA_API_KEY=
# Re-embed course content every minute on the legacy path. Leave off for Bedrock.
ENABLE_EMBEDDING_SYNC=false

# =====================================================
#  AWS / Amazon Bedrock  (the AWS-native tutor path)
# =====================================================
# AWS credentials come from the standard provider chain
# (env vars, shared config, or an IAM role in deployment):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  (local dev)
# In production prefer an IAM role — do not commit keys.

AWS_REGION=us-east-1

# --- Retrieval: Amazon Bedrock Knowledge Base ---
# When set, the tutor retrieves course context (with citations)
# from this KB instead of Jina + MongoDB Atlas.
BEDROCK_KB_ID=

# --- Generation: Amazon Bedrock LLM ---
# Set USE_BEDROCK=true to generate answers with Bedrock instead of Groq.
USE_BEDROCK=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# If invoking this errors asking for an inference profile, use the
# cross-region profile ID instead (note the region prefix):
#   us.amazon.nova-lite-v1:0
# Others: anthropic.claude-3-5-sonnet-20240620-v1:0 | meta.llama3-70b-instruct-v1:0

# --- Safety: Bedrock Guardrails (optional but recommended for a student tutor) ---
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
