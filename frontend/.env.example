# VidyaAI frontend — environment variables
# Copy to .env and fill in for local dev / deployment.

# URL of the backend.
# Local dev: http://localhost:5002 (matches PORT in backend/.env.example)
# Production: the deployed backend URL, e.g. your App Runner HTTPS endpoint.
# If this is unset at build time the app falls back to localhost, which fails
# in production — set it in the Amplify build environment, not just locally.
VITE_BACKEND_URL="http://localhost:5002"
